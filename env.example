# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit file .env.
# Phải có dấu / ở cuối.
BASE_URL=https://<domain-gateway>/api/v1/

# Tài khoản test (username = MSHV hoặc mã GV)
GIAOVU_USER=giaovu01
GIAOVU_PASS=
GVHD_USER=gvhd01
GVHD_PASS=
NCS_USER=ncs01
NCS_PASS=
# NCS mới tạo: mốc 1 PASSED, mốc 2 UNLOCKED, mốc 3 LOCKED (dùng cho TC21)
NCS_NEW_USER=ncs_moi
NCS_NEW_PASS=

# Tùy chọn: documentId của tài liệu thuộc NCS khác (dùng cho TC16). Bỏ trống thì TC16 tự skip.
DOC_ID_OF_OTHER_NCS=
